            request.resource.data.version > 1
            && isNonEmptyString(
              request.resource.data.replacesCycleId,
              300
            )
            && billingControlAfter(
              ownerId,
              request.resource.data.replacesCycleId
            ).reissuedAsCycleId == cycleId
          )
        );

      allow update, delete: if false;
    }

    match /owners/{ownerId}/boardingHouses/{houseId}/billingCycleControls/{cycleId} {
      allow read: if isPrimaryHouseOwner(ownerId, houseId);

      allow create: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidBillingCycleControl(request.resource.data, cycleId)
        && request.resource.data.state == 'active'
        && request.resource.data.totalPaidCentavos == 0
        && request.resource.data.outstandingCentavos
          == request.resource.data.totalBilledCentavos
        && request.resource.data.lastPaymentId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && billingCycleAfter(ownerId, cycleId).totalBilledCentavos
          == request.resource.data.totalBilledCentavos;

      allow update: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidBillingCycleControl(request.resource.data, cycleId)
        && request.resource.data.billingCycleId
          == resource.data.billingCycleId
        && request.resource.data.totalBilledCentavos
          == resource.data.totalBilledCentavos
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.state == 'active'
            && request.resource.data.state == 'active'
            && request.resource.data.voidReason == resource.data.voidReason
            && request.resource.data.voidedAt == resource.data.voidedAt
            && request.resource.data.reissuedAsCycleId
              == resource.data.reissuedAsCycleId
            && request.resource.data.totalPaidCentavos
              > resource.data.totalPaidCentavos
            && request.resource.data.lastPaymentId != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'totalPaidCentavos',
              'outstandingCentavos',
              'lastPaymentId',
              'updatedAt'
            ])
            && paymentAfter(
              ownerId,
              request.resource.data.lastPaymentId
            ).billingCycleId == cycleId
            && request.resource.data.totalPaidCentavos
              == resource.data.totalPaidCentavos
                + paymentAfter(
                  ownerId,
                  request.resource.data.lastPaymentId
                ).amountCentavos
          )
          || (
            resource.data.state == 'active'
            && resource.data.totalPaidCentavos == 0
            && request.resource.data.state == 'voided'
            && request.resource.data.totalPaidCentavos == 0
            && request.resource.data.lastPaymentId
              == resource.data.lastPaymentId
            && request.resource.data.reissuedAsCycleId
              == resource.data.reissuedAsCycleId
            && request.resource.data.voidedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'state',
              'voidReason',
              'voidedAt',
              'updatedAt'
            ])
            && billingPeriodAfter(
              ownerId,
              billingCycleBefore(ownerId, cycleId).periodId
            ).activeCycleId == null
          )
          || (
            resource.data.state == 'voided'
            && request.resource.data.state == 'voided'
            && resource.data.reissuedAsCycleId == null
            && isNonEmptyString(
              request.resource.data.reissuedAsCycleId,
              300
            )
            && request.resource.data.totalPaidCentavos
              == resource.data.totalPaidCentavos
            && request.resource.data.outstandingCentavos
              == resource.data.outstandingCentavos
            && request.resource.data.lastPaymentId
              == resource.data.lastPaymentId
            && request.resource.data.voidReason == resource.data.voidReason
            && request.resource.data.voidedAt == resource.data.voidedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reissuedAsCycleId',
              'updatedAt'
            ])
            && billingCycleAfter(
              ownerId,
              request.resource.data.reissuedAsCycleId
            ).replacesCycleId == cycleId
          )
        );

      allow delete: if false;
    }

    match /owners/{ownerId}/boardingHouses/{houseId}/boarderBillAccounts/{accountId} {
      allow read: if isPrimaryHouseOwner(ownerId, houseId);

      allow create: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidBoarderBillAccount(request.resource.data, accountId)
        && request.resource.data.totalPaidCentavos == 0
        && request.resource.data.lastPaymentId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidBoarderBillAccount(request.resource.data, accountId)
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.billingCycleId
          == resource.data.billingCycleId
        && request.resource.data.boarderId == resource.data.boarderId
        && request.resource.data.boarderName == resource.data.boarderName
        && request.resource.data.totalChargesCentavos
          == resource.data.totalChargesCentavos
        && request.resource.data.previousBalanceCentavos
          == resource.data.previousBalanceCentavos
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.totalPaidCentavos
          > resource.data.totalPaidCentavos
        && request.resource.data.lastPaymentId != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalPaidCentavos',
          'lastPaymentId',
          'updatedAt'
        ])
        && paymentAfter(
          ownerId,
          request.resource.data.lastPaymentId
        ).accountId == accountId
        && request.resource.data.totalPaidCentavos
          == resource.data.totalPaidCentavos
            + paymentAfter(
              ownerId,
              request.resource.data.lastPaymentId
            ).amountCentavos;

      allow delete: if false;
    }

    match /owners/{ownerId}/boardingHouses/{houseId}/payments/{paymentId} {
      allow read: if isPrimaryHouseOwner(ownerId, houseId);

      allow create: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidPayment(request.resource.data, paymentId, ownerId)
        && request.resource.data.createdAt == request.time
        && billAccountBefore(
          ownerId,
          request.resource.data.accountId
        ).billingCycleId == request.resource.data.billingCycleId
        && billAccountBefore(
          ownerId,
          request.resource.data.accountId
        ).boarderId == request.resource.data.boarderId
        && billAccountBefore(
          ownerId,
          request.resource.data.accountId
        ).boarderName == request.resource.data.boarderName
        && billAccountAfter(
          ownerId,
          request.resource.data.accountId
        ).lastPaymentId == paymentId
        && billAccountAfter(
          ownerId,
          request.resource.data.accountId
        ).totalPaidCentavos
          == billAccountBefore(
            ownerId,
            request.resource.data.accountId
          ).totalPaidCentavos + request.resource.data.amountCentavos
        && billingControlBefore(
          ownerId,
          request.resource.data.billingCycleId
        ).state == 'active'
        && billingControlAfter(
          ownerId,
          request.resource.data.billingCycleId
        ).lastPaymentId == paymentId
        && billingControlAfter(
          ownerId,
          request.resource.data.billingCycleId
        ).totalPaidCentavos
          == billingControlBefore(
            ownerId,
            request.resource.data.billingCycleId
          ).totalPaidCentavos + request.resource.data.amountCentavos;

      allow update, delete: if false;
    }

    match /owners/{ownerId}/boardingHouses/{houseId}/roomBillingPeriods/{periodId} {
      allow read: if isPrimaryHouseOwner(ownerId, houseId);

      allow create: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidBillingPeriod(request.resource.data, periodId)
        && request.resource.data.activeCycleId
          == request.resource.data.latestCycleId
        && request.resource.data.latestVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && roomBillingCycleAfter(
          ownerId,
          request.resource.data.activeCycleId
        ).periodId == periodId;

      allow update: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidBillingPeriod(request.resource.data, periodId)
        && request.resource.data.periodId == resource.data.periodId
        && request.resource.data.startDate == resource.data.startDate
        && request.resource.data.endDateExclusive
          == resource.data.endDateExclusive
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'activeCycleId',
          'latestCycleId',
          'latestVersion',
          'updatedAt'
        ])
        && (
          (
            resource.data.activeCycleId != null
            && request.resource.data.activeCycleId == null
            && request.resource.data.latestCycleId
              == resource.data.latestCycleId
            && request.resource.data.latestVersion
              == resource.data.latestVersion
            && roomBillingControlAfter(
              ownerId,
              resource.data.activeCycleId
            ).state == 'voided'
          )
          || (
            resource.data.activeCycleId == null
            && request.resource.data.activeCycleId
              == request.resource.data.latestCycleId
            && request.resource.data.latestVersion
              == resource.data.latestVersion + 1
            && roomBillingCycleAfter(
              ownerId,
              request.resource.data.activeCycleId
            ).version == request.resource.data.latestVersion
            && roomBillingCycleAfter(
              ownerId,
              request.resource.data.activeCycleId
            ).replacesCycleId == resource.data.latestCycleId
          )
        );

      allow delete: if false;
    }

    match /owners/{ownerId}/boardingHouses/{houseId}/roomBillingCycles/{cycleId} {
      allow read: if isPrimaryHouseOwner(ownerId, houseId);

      allow create: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidRoomBillingCycle(request.resource.data, cycleId, ownerId)
        && request.resource.data.createdAt == request.time
        && roomBillingPeriodAfter(
          ownerId,
          request.resource.data.periodId
        ).activeCycleId == cycleId
        && roomBillingPeriodAfter(
          ownerId,
          request.resource.data.periodId
        ).latestCycleId == cycleId
        && roomBillingPeriodAfter(
          ownerId,
          request.resource.data.periodId
        ).latestVersion == request.resource.data.version
        && (
          (
            request.resource.data.version == 1
            && request.resource.data.replacesCycleId == null
          )
          || (
            request.resource.data.version > 1
            && isNonEmptyString(
              request.resource.data.replacesCycleId,
              300
            )
            && roomBillingControlAfter(
              ownerId,
              request.resource.data.replacesCycleId
            ).reissuedAsCycleId == cycleId
          )
        );

      allow update, delete: if false;
    }

    match /owners/{ownerId}/boardingHouses/{houseId}/roomBillingControls/{cycleId} {
      allow read: if isPrimaryHouseOwner(ownerId, houseId);

      allow create: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidBillingCycleControl(request.resource.data, cycleId)
        && request.resource.data.state == 'active'
        && request.resource.data.totalPaidCentavos == 0
        && request.resource.data.outstandingCentavos
          == request.resource.data.totalBilledCentavos
        && request.resource.data.lastPaymentId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && roomBillingCycleAfter(ownerId, cycleId).totalBilledCentavos
          == request.resource.data.totalBilledCentavos;

      allow update: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidBillingCycleControl(request.resource.data, cycleId)
        && request.resource.data.billingCycleId
          == resource.data.billingCycleId
        && request.resource.data.totalBilledCentavos
          == resource.data.totalBilledCentavos
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.state == 'active'
            && request.resource.data.state == 'active'
            && request.resource.data.voidReason == resource.data.voidReason
            && request.resource.data.voidedAt == resource.data.voidedAt
            && request.resource.data.reissuedAsCycleId
              == resource.data.reissuedAsCycleId
            && request.resource.data.totalPaidCentavos
              > resource.data.totalPaidCentavos
            && request.resource.data.lastPaymentId != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'totalPaidCentavos',
              'outstandingCentavos',
              'lastPaymentId',
              'updatedAt'
            ])
            && roomPaymentAfter(
              ownerId,
              request.resource.data.lastPaymentId
            ).billingCycleId == cycleId
            && request.resource.data.totalPaidCentavos
              == resource.data.totalPaidCentavos
                + roomPaymentAfter(
                  ownerId,
                  request.resource.data.lastPaymentId
                ).amountCentavos
          )
          || (
            resource.data.state == 'active'
            && resource.data.totalPaidCentavos == 0
            && request.resource.data.state == 'voided'
            && request.resource.data.totalPaidCentavos == 0
            && request.resource.data.lastPaymentId
              == resource.data.lastPaymentId
            && request.resource.data.reissuedAsCycleId
              == resource.data.reissuedAsCycleId
            && request.resource.data.voidedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'state',
              'voidReason',
              'voidedAt',
              'updatedAt'
            ])
            && roomBillingPeriodAfter(
              ownerId,
              roomBillingCycleBefore(ownerId, cycleId).periodId
            ).activeCycleId == null
          )
          || (
            resource.data.state == 'voided'
            && request.resource.data.state == 'voided'
            && resource.data.reissuedAsCycleId == null
            && isNonEmptyString(
              request.resource.data.reissuedAsCycleId,
              300
            )
            && request.resource.data.totalPaidCentavos
              == resource.data.totalPaidCentavos
            && request.resource.data.outstandingCentavos
              == resource.data.outstandingCentavos
            && request.resource.data.lastPaymentId
              == resource.data.lastPaymentId
            && request.resource.data.voidReason == resource.data.voidReason
            && request.resource.data.voidedAt == resource.data.voidedAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reissuedAsCycleId',
              'updatedAt'
            ])
            && roomBillingCycleAfter(
              ownerId,
              request.resource.data.reissuedAsCycleId
            ).replacesCycleId == cycleId
          )
        );

      allow delete: if false;
    }

    match /owners/{ownerId}/boardingHouses/{houseId}/roomBillAccounts/{accountId} {
      allow read: if isPrimaryHouseOwner(ownerId, houseId);

      allow create: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidRoomBillAccount(request.resource.data, accountId)
        && request.resource.data.totalPaidCentavos == 0
        && request.resource.data.lastPaymentId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && roomBillingCycleAfter(
          ownerId,
          request.resource.data.billingCycleId
        ).billingCycleId == request.resource.data.billingCycleId
        && request.resource.data.totalChargesCentavos
          <= roomBillingCycleAfter(
            ownerId,
            request.resource.data.billingCycleId
          ).totalBilledCentavos;

      allow update: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidRoomBillAccount(request.resource.data, accountId)
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.billingCycleId
          == resource.data.billingCycleId
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.roomName == resource.data.roomName
        && request.resource.data.totalChargesCentavos
          == resource.data.totalChargesCentavos
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.totalPaidCentavos
          > resource.data.totalPaidCentavos
        && request.resource.data.lastPaymentId != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'totalPaidCentavos',
          'lastPaymentId',
          'updatedAt'
        ])
        && roomPaymentAfter(
          ownerId,
          request.resource.data.lastPaymentId
        ).accountId == accountId
        && request.resource.data.totalPaidCentavos
          == resource.data.totalPaidCentavos
            + roomPaymentAfter(
              ownerId,
              request.resource.data.lastPaymentId
            ).amountCentavos;

      allow delete: if false;
    }

    match /owners/{ownerId}/boardingHouses/{houseId}/roomPayments/{paymentId} {
      allow read: if isPrimaryHouseOwner(ownerId, houseId);

      allow create: if isPrimaryHouseOwner(ownerId, houseId)
        && isValidRoomPayment(request.resource.data, paymentId, ownerId)
        && request.resource.data.createdAt == request.time
        && roomBillAccountBefore(
          ownerId,
          request.resource.data.accountId
        ).billingCycleId == request.resource.data.billingCycleId
        && roomBillAccountBefore(
          ownerId,
          request.resource.data.accountId
        ).roomId == request.resource.data.roomId
        && roomBillAccountBefore(
          ownerId,
          request.resource.data.accountId
        ).roomName == request.resource.data.roomName
        && roomBillAccountAfter(
          ownerId,
          request.resource.data.accountId
        ).lastPaymentId == paymentId
        && roomBillAccountAfter(
          ownerId,
          request.resource.data.accountId
        ).totalPaidCentavos
          == roomBillAccountBefore(
            ownerId,
            request.resource.data.accountId
          ).totalPaidCentavos + request.resource.data.amountCentavos
        && roomBillingControlBefore(
          ownerId,
          request.resource.data.billingCycleId
        ).state == 'active'
        && roomBillingControlAfter(
          ownerId,
          request.resource.data.billingCycleId
        ).lastPaymentId == paymentId
        && roomBillingControlAfter(
          ownerId,
          request.resource.data.billingCycleId
        ).totalPaidCentavos
          == roomBillingControlBefore(
            ownerId,
            request.resource.data.billingCycleId
          ).totalPaidCentavos + request.resource.data.amountCentavos;

      allow update, delete: if false;
    }

    // Undeclared collections remain fail-closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
